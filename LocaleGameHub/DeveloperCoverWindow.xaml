<Window x:Class="LocaleGameHub.DeveloperCoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portada del developer · VNAR" Icon="Resources/VNAR.ico"
        Height="650" Width="760" MinHeight="560" MinWidth="680"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Vista previa" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Height="430" Background="#080C12" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                    CornerRadius="10" ClipToBounds="True" AllowDrop="True" DragOver="Cover_DragOver" Drop="Cover_Drop">
                <Grid>
                    <Image x:Name="CoverPreview" Stretch="UniformToFill"/>
                    <TextBlock x:Name="FallbackNameText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="26"/>
                    <Border VerticalAlignment="Bottom" Background="#D00A0F17" Padding="9">
                        <TextBlock Text="Arrastra una imagen aquí" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Portada del developer" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="DeveloperNameText" Foreground="{StaticResource AccentHoverBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock x:Name="DeveloperIdText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                    CornerRadius="10" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Imagen" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="La API actual de VNDB no expone una imagen para producers/developers. Puedes elegir una imagen propia y ajustarla con el mismo editor de portadas de los juegos."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Elegir / reemplazar imagen…" Click="ChooseImage_Click" Margin="0,0,0,8"/>
                    <Button x:Name="EditButton" Style="{StaticResource PrimaryButton}" Content="Editar encuadre…" Click="EditCover_Click" Margin="0,0,0,8"/>
                    <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Content="Quitar portada" Click="RemoveCover_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
