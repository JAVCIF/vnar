<Window x:Class="LocaleGameHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNAR" Icon="Resources/VNAR.ico" Height="780" Width="1200" MinHeight="620" MinWidth="900" WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VNAR" FontSize="34" FontWeight="Bold" FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource BrandTitleBrush}"/>
                <TextBlock Text="Visual Novels, un clic y listo." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Click="AddExe_Click" Margin="0,0,8,0" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Añadir EXE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="ScanFolder_Click" Margin="0,0,8,0" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Escanear carpeta" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="Settings_Click" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ajustes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="LocaleBanner" Background="{StaticResource AccentDimBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Configurar" Click="Settings_Click" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ⓘ" Foreground="{StaticResource AccentBrush}" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LocaleBannerText" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="AllTabButton" Style="{StaticResource LibraryTabButton}" Content="Todos" Click="AllTab_Click" Tag="active" Margin="0,0,8,0"/>
                <Button x:Name="FavoritesTabButton" Style="{StaticResource LibraryTabButton}" Content="Favoritos" Click="FavoritesTab_Click" Margin="0,0,8,0"/>
                <Button x:Name="DevelopersTabButton" Style="{StaticResource LibraryTabButton}" Content="Developers" Click="DevelopersTab_Click"/>
            </StackPanel>

            <Border Grid.Row="1" x:Name="DeveloperNavPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="DeveloperBackButton" Style="{StaticResource SecondaryButton}" Content="← Developers"
                            Click="DeveloperBack_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DeveloperPathText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeveloperHintText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="RefreshDevelopersButton" Style="{StaticResource SecondaryButton}"
                            Content="↻ Actualizar desde VNDB" Click="RefreshDevelopers_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="40" FontSize="14" TextChanged="SearchBox_TextChanged"
                         ToolTip="Buscar por nombre o ruta" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <Grid Grid.Row="3">
                <ScrollViewer x:Name="GamesScroll" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
                    <ItemsControl x:Name="GamesItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="0,0,16,18" Background="{StaticResource PanelBrush}" CornerRadius="11"
                                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                        Tag="{Binding Game}" ContextMenuOpening="GameCard_ContextMenuOpening">
                                    <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="300"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="CoverArea" Background="#080C12" CornerRadius="10,10,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Game.CoverPath}" Stretch="UniformToFill" Tag="{Binding Game}"
                                                       MouseLeftButtonDown="Cover_MouseLeftButtonDown" Cursor="Hand"/>
                                                <Border x:Name="TitleOverlay" VerticalAlignment="Bottom" Background="#D00A0F17" Padding="9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCover}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasCover}" Value="True"/>
                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=CoverArea}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Game.Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44"/>
                                                </Border>
                                                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"
                                                        Style="{StaticResource FavoriteStarButton}" Click="FavoriteStar_Click"
                                                        Tag="{Binding Game}" ToolTip="{Binding FavoriteTooltip}">
                                                    <TextBlock FontFamily="Segoe UI Symbol" FontSize="23" FontWeight="Bold" Margin="0,-2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="☆"/>
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Game.Favorite}" Value="True">
                                                                        <Setter Property="Text" Value="★"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D0162E55" CornerRadius="0,9,0,8" Padding="8,5">
                                                    <TextBlock Text="JP" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="11">
                                            <CheckBox Content="{Binding AdminLabel}" Foreground="{StaticResource TextBrush}"
                                                      IsChecked="{Binding Game.RunAsAdmin, Mode=TwoWay}" Tag="{Binding Game}"
                                                      Checked="AdminToggle_Changed" Unchecked="AdminToggle_Changed" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding PlayLabel}" Click="Play_Click" Tag="{Binding Game}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="•••" Click="Edit_Click" Tag="{Binding Game}" ToolTip="{Binding EditTooltip}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="DevelopersScroll" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                    <ItemsControl x:Name="DevelopersItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Height="300" Margin="0,0,16,18" Background="{StaticResource PanelBrush}" CornerRadius="11"
                                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                        Tag="{Binding Developer}" ToolTip="{Binding Developer.Name}"
                                        MouseLeftButtonDown="DeveloperCard_MouseLeftButtonDown" ContextMenuOpening="DeveloperCard_ContextMenuOpening" Cursor="Hand">
                                    <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
                                    <Grid ClipToBounds="True">
                                        <Image Source="{Binding Developer.CoverPath}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Developer.Name}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="20"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="24">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#D00A0F17" CornerRadius="8,0,10,0" Padding="8,5">
                                            <TextBlock Text="{Binding GameCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="EmptyState" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                        <TextBlock x:Name="EmptyIconText" Text="🎮" FontSize="54" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitleText" Text="Tu biblioteca está vacía" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,8" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescriptionText" Text="Arrastra aquí un .exe o una carpeta de juegos, añade un ejecutable o escanea una biblioteca completa."
                                   Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" x:Name="PaginationPanel" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevPageButton" Style="{StaticResource SecondaryButton}" Content="Anterior" Click="PrevPage_Click" Margin="0,0,10,0"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <TextBlock x:Name="PageText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="NextPageButton" Style="{StaticResource SecondaryButton}" Content="Siguiente" Click="NextPage_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="Tip: también puedes arrastrar EXE o carpetas directamente sobre VNAR."/>
    </Grid>
</Window>
