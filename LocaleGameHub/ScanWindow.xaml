<Window x:Class="LocaleGameHub.ScanWindow" Icon="Resources/VNAR.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultados del escaneo" Height="650" Width="900" MinHeight="500" MinWidth="720"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BgBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ejecutables encontrados" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Marca solo los ejecutables principales. El escáner evita instaladores y utilidades comunes, pero tú tienes la última palabra."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <Button Style="{StaticResource SecondaryButton}" Content="Seleccionar todos" Click="SelectAll_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Ninguno" Click="SelectNone_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
            <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Añadir" Binding="{Binding Selected, Mode=TwoWay}" Width="70"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name, Mode=TwoWay}" Width="220"/>
                    <DataGridTextColumn Header="Ejecutable" Binding="{Binding ExePath}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Añadir seleccionados" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
