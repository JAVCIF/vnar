<Window x:Class="LocaleGameHub.CoverEditorWindow" Icon="Resources/VNAR.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar portada · VNAR" Height="790" Width="1010" MinHeight="700" MinWidth="920"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <VisualBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="20" Height="20">
                        <Rectangle Fill="#FFF0F0F0"/>
                        <Rectangle Fill="#FFD8D8D8" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Rectangle Fill="#FFD8D8D8" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Resources>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Vista previa" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Width="310" Height="430" Background="#080C12" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                    CornerRadius="10" ClipToBounds="True">
                <Grid x:Name="PreviewHost" Width="310" Height="430" Background="Black" MouseWheel="PreviewHost_MouseWheel">
                    <Rectangle x:Name="TransparentPattern" Fill="{StaticResource CheckerBrush}" Visibility="Collapsed"/>
                    <Canvas x:Name="BlurBackgroundCanvas" Width="310" Height="430" Background="Transparent" ClipToBounds="True" Visibility="Collapsed">
                        <Image x:Name="BlurBackgroundImage" Stretch="Fill" Opacity="0.82">
                            <Image.Effect>
                                <BlurEffect Radius="22"/>
                            </Image.Effect>
                        </Image>
                    </Canvas>
                    <Canvas x:Name="PreviewCanvas" Width="310" Height="430" Background="Transparent" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Fill"
                               MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                               MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                               MouseMove="PreviewImage_MouseMove"
                               Cursor="SizeAll"/>
                    </Canvas>
                    <Border BorderBrush="#75FFFFFF" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <TextBlock Text="La imagen inicia completa dentro del marco, sin recortes automáticos. Luego tú decides si acercarla, alejarla o moverla." 
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
            <StackPanel>
                <TextBlock Text="Ajustes de portada" FontSize="25" FontWeight="Bold"/>
                <TextBlock x:Name="ImageInfoText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Zoom" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="1.00×" x:Name="ZoomText" Foreground="{StaticResource TextBrush}" Margin="0,10,0,6"/>
                        <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="4.0" Value="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="False" ValueChanged="ZoomSlider_ValueChanged"/>
                        <TextBlock Text="1.00× muestra la imagen completa ajustada al marco. Usa la rueda del mouse para cambiar el zoom más rápido."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Relleno del fondo" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Útil para imágenes rectangulares o pequeñas cuando no quieres recortar agresivamente." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/>
                        <ComboBox x:Name="BackgroundModeCombo" SelectionChanged="BackgroundModeCombo_SelectionChanged">
                            <ComboBoxItem Content="Negro" Tag="black" IsSelected="True"/>
                            <ComboBoxItem Content="Blanco" Tag="white"/>
                            <ComboBoxItem Content="Transparente" Tag="transparent"/>
                            <ComboBoxItem Content="Desenfoque con la misma imagen" Tag="blur"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Posición" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Puedes arrastrar con el mouse o usar pequeños ajustes finos." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"/>
                        <UniformGrid Columns="3" Rows="2">
                            <Border/>
                            <Button Style="{StaticResource SecondaryButton}" Content="↑" Click="MoveUp_Click" Margin="4"/>
                            <Border/>
                            <Button Style="{StaticResource SecondaryButton}" Content="←" Click="MoveLeft_Click" Margin="4"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Centrar" Click="Center_Click" Margin="4"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="→" Click="MoveRight_Click" Margin="4"/>
                        </UniformGrid>
                        <Button Style="{StaticResource SecondaryButton}" Content="↓" Click="MoveDown_Click" Margin="4,4,4,0" HorizontalAlignment="Center" Width="82"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Resultado" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="16"/>
                        <CheckBox x:Name="ImproveQualityCheck" Content="Mejorar calidad antes de guardar (exportar a mayor resolución para reducir pixelado)"
                                  Margin="0,10,0,0" Checked="QualityMode_Changed" Unchecked="QualityMode_Changed"/>
                        <TextBlock x:Name="OutputInfoText" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="Al aplicar, se generará una nueva imagen PNG desde la fuente original, conservando estos ajustes para futuras ediciones." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Restablecer" Click="Reset_Click" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Aplicar" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
