<Window x:Class="LocaleGameHub.CoverSearchWindow" Icon="Resources/VNAR.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar portada · VNAR" Height="760" Width="1060" MinHeight="620" MinWidth="880"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BgBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Buscar portada" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Busca por el nombre del juego y elige una de las primeras coincidencias sin salir del Hub."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" MinHeight="38" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"/>
            <ComboBox Grid.Column="1" x:Name="ProviderCombo" Margin="10,0,0,0" MinHeight="38" VerticalContentAlignment="Center"
                      SelectionChanged="ProviderCombo_SelectionChanged">
                <ComboBoxItem Content="VNDB · automático" Tag="vndb" IsSelected="True"/>
                <ComboBoxItem Content="Google Images · SerpApi" Tag="google"/>
            </ComboBox>
            <Button Grid.Column="2" x:Name="SearchButton" Style="{StaticResource PrimaryButton}" Content="Buscar" Click="Search_Click" Margin="10,0,0,0"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                CornerRadius="8" Padding="11" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="VNDB no necesita API key y suele ser la mejor fuente para novelas visuales."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Result_Click" Tag="{Binding}" Width="184" Height="300" Margin="0,0,12,12"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                    CornerRadius="10" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="220"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#080C12" CornerRadius="7" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="42" Margin="2,8,2,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="2,5,2,0"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Tip: también puedes arrastrar una imagen directamente desde Chrome/Edge hasta la portada del editor."
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BrowserFallbackButton" Style="{StaticResource SecondaryButton}" Content="Abrir Google Images ↗"
                        Click="BrowserFallback_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Cerrar" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
